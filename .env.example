# ========================================
# Application Configuration
# ========================================

# Environment: development | staging | production
APP_ENV=development
APP_NAME=TIMIMA
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ROUTER_PREFIX=/api/v1
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_URL_FRONTEND=http://localhost:3000

# ========================================
# CORS Configuration
# ========================================
# CRITICAL: Never use "*" in production!
# List specific origins separated by commas
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Request-ID

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=85mzCYreuplkcc6Y
DB_NAME=timimamori01
DB_ECHO=false

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Read Database (Optional - for read replicas)
DB_READ_HOST=localhost
DB_READ_PORT=5432
DB_READ_USER=postgres
DB_READ_PASSWORD=85mzCYreuplkcc6Y
DB_READ_NAME=timimamori01
DB_READ_POOL_SIZE=10
DB_READ_MAX_OVERFLOW=20

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ========================================
# JWT Configuration
# ========================================
# CRITICAL: Generate a secure random secret!
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=4sWTp6X1nrM9LHF1oPEOi3bqCH4BFiM7niYjHGNrXPNC95yLEDL0CWQavJ7AF3LzC6l0r1fFrIYP8sj0izi2tQ
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=fastapi-app
JWT_AUDIENCE=fastapi-users

# ========================================
# Security
# ========================================
ENABLE_SECURITY_HEADERS=true
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900
SESSION_TIMEOUT=3600
ENABLE_2FA=false

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60/minute
RATE_LIMIT_PER_USER_MINUTE=100
RATE_LIMIT_ANONYMOUS_MINUTE=10

# ========================================
# Logging Configuration
# ========================================
LOGGING_LEVEL=INFO
LOGGING_BACKUP_DAYS=30
LOGGING_JSON_FORMAT=true
LOGGING_REQUEST_BODY=true
LOGGING_RESPONSE_BODY=false
LOGGING_REQUEST_BODY_MAX_SIZE=10000
LOGGING_SLOW_REQUEST_THRESHOLD=1.0

# ==================== STORAGE SETTINGS ====================
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=public
STORAGE_LOCAL_BASE_URL=http://localhost:8000

# S3 Storage (Required when STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET_NAME=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_PUBLIC_URL=
STORAGE_S3_ACL=private

# ==================== STORAGE S3 PERFORMANCE ====================
STORAGE_S3_COMPRESS=false
STORAGE_S3_COMPRESS_MIN_SIZE=1024
STORAGE_S3_COMPRESS_MAX_SIZE=5242880
STORAGE_S3_COMPRESS_CONTENT_TYPES=text/plain,text/html,text/css,application/json,application/javascript,application/xml,text/xml
STORAGE_S3_MULTIPART_THRESHOLD=8388608
STORAGE_S3_MULTIPART_CHUNK_SIZE=8388608
STORAGE_S3_MAX_POOL_CONNECTIONS=20
STORAGE_S3_RETRY_MAX_ATTEMPTS=5
STORAGE_S3_RETRY_BASE_DELAY=0.2
STORAGE_S3_RETRY_MAX_DELAY=2.0

# ==================== MAIL SETTING ====================
MAIL_PROVIDER=fastapi-mail
MAIL_SERVER=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@timima.com
MAIL_FROM_NAME=TIMIMA
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false
MAIL_VALIDATE_CERTS=false
MAIL_TEMPLATE_FOLDER=src/templates

# ========================================
# Docker Configuration (Development)
# ========================================
COMPOSE_PROJECT_NAME=timima

# PostgreSQL Performance Tuning (Docker only)
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_WORK_MEM=8MB

# Redis Performance (Docker only)
REDIS_MAX_MEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lru
