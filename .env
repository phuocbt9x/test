# Docker Compose project name
COMPOSE_PROJECT_NAME=timima

# App
APP_NAME=TIMIMA
APP_ENV=development
APP_TIMEZONE=Asia/Tokyo
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ROUTER_PREFIX=/api/v1

# CORS_ORIGINS: Only specify origins that are truly necessary, do not use * or leave empty!
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Database (write)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_PORT_EXTERNAL=5433
DB_USER=timima
DB_PASSWORD=timima
DB_NAME=timima
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Database (read, optional)
# If you want to separate read DB, configure the variables below. If not, the app will use write DB for both read/write.
#DB_READ_HOST=postgres
#DB_READ_PORT=5432
#DB_READ_PORT_EXTERNAL=5433
#DB_READ_USER=postgres
#DB_READ_PASSWORD=postgres
#DB_READ_NAME=timima
#DB_READ_POOL_SIZE=10
#DB_READ_MAX_OVERFLOW=20

# Docker Postgres settings
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=100

# Redis connection settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Docker Redis settings
REDIS_MAX_MEMORY=256mb
REDIS_MAX_CONNECTIONS=100
REDIS_DECODE_RESPONSES=true

# JWT
# REQUIRED: Set a strong JWT_SECRET string, do not leave empty when deploying to production!
JWT_SECRET=your_super_secret_key_1234567890abcdef).
JWT_EXPIRES=3600
JWT_REFRESH_EXPIRES=86400

# Logging
LOGGING_LEVEL=INFO
LOGGING_BACKUP_DAYS=30
LOGGING_JSON_FORMAT=true
LOGGING_REQUEST_BODY=true
LOGGING_RESPONSE_BODY=false
LOGGING_REQUEST_BODY_MAX_SIZE=10000
LOGGING_SLOW_REQUEST_THRESHOLD=1.0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE="100/minute"  # e.g., "100/minute"
